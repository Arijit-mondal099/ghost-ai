# Ghost AI — example environment. Copy to `.env.local` and fill in real values.
# Never commit real secrets. Only NEXT_PUBLIC_* vars reach the browser.

# --- Database (Neon Postgres, direct TCP — NOT prisma+postgres://) ---
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&channel_binding=require"

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Liveblocks (realtime canvas) ---
LIVEBLOCKS_SECRET_KEY="sk_..."

# --- Trigger.dev (background AI tasks) ---
TRIGGER_PROJECT_REF="proj_..."
TRIGGER_SECRET_KEY="tr_..."

# --- Groq (LLM for design-agent + generate-spec) ---
GROQ_API_KEY="gsk_..."
# Optional spec length override (256-32000, default 1000)
# GROQ_SPEC_MAX_TOKENS="1000"

# --- Vercel Blob (private store: canvas snapshots + specs) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# --- Upstash Redis (rate limiting + read-through cache) ---
UPSTASH_REDIS_REST_URL="https://....upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."
